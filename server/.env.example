# Шаблон конфигурации сервера. Скопируйте в server/.env и заполните:
#   cp server/.env.example server/.env
# Обязательно поменяйте: секреты JWT, пароль администратора, SMTP-доступ.

# ── Приложение ──
PORT=3000
# development включает synchronize схемы БД и SQL-логирование (только для dev)
NODE_ENV=production

# ── PostgreSQL (имена хостов = имена сервисов из docker-compose) ──
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=barter

# ── Redis (троттлинг, сессии, pub/sub уведомлений, архив лотов) ──
REDIS_HOST=redis
REDIS_PORT=6379

# ── Учётная запись администратора (создаётся сидом при первом запуске) ──
ADMIN_EMAIL=admin@barter.local
ADMIN_LOGIN=admin
ADMIN_NAME=Admin
ADMIN_PASSWORD=change_me

# ── JWT-секреты (access/refresh токены) ──
ACCESS_TOKEN_SECRET=change_me_access
REFRESH_TOKEN_SECRET=change_me_refresh

# ── Лимит одновременных сессий на аккаунт ──
MAX_SESSIONS=3

# ── SMTP: письма подтверждения почты, сброса пароля, деактивации ──
EMAIL_HOST=smtp.example.com
EMAIL_USERNAME=mailer@example.com
EMAIL_PASSWORD=change_me

# ── Адрес клиента (ссылки в письмах) ──
FRONTEND_URL=http://localhost

# ── Сиды ──
# SEED — справочники (география, каталог) + администратор; идемпотентно
SEED=true
# SEED_DEV — тестовые пользователи/лоты/предложения (только для разработки)
SEED_DEV=false
DEFAULT_PASSWORD=default_password

# ── Антивирус вложений чата (ClamAV) ──
# По умолчанию выключен: файлы сохраняются без проверки (dev/offline).
# Для включения: ANTIVIRUS_ENABLED=true + раскомментировать сервис clamav
# в docker-compose (см. docker/docker-compose.prod.yml).
ANTIVIRUS_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
