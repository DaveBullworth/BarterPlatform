# Шаблон конфигурации клиента. Скопируйте в client/.env:
#   cp client/.env.example client/.env

# База API. В docker-стеке — /api (nginx клиента проксирует на server:3000).
# При локальной разработке без nginx — http://localhost:3000
VITE_API_URL=/api

# Контакты поддержки, показываемые в интерфейсе
SUPPORT_EMAIL=support@example.com
SUPPORT_TELEGRAM=@support
